# rf.lock 初期配置(post-fs-data の init exec、一回実行)。作成と属性確認のみ。flock/書込み/削除はしない。
type l01ktv_rflock_init, domain;
type l01ktv_rflock_init_exec, exec_type, vendor_file_type, file_type;
init_daemon_domain(l01ktv_rflock_init)

allow l01ktv_rflock_init vendor_data_file:dir search;
# 親(/data/vendor/l01ktv)を O_DIRECTORY で開き、rf.lock を O_CREAT|O_EXCL で作る。鍵(l01ktv_config_file)には触れない。
allow l01ktv_rflock_init l01ktv_state_file:dir { open read search getattr write add_name };
allow l01ktv_rflock_init l01ktv_state_file:file { create open read getattr };
